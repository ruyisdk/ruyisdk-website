    "generate-packages-api": "python3 scripts/generate_packages_api.py",
    "dev": "dotenv -e .env.development -- cross-env NODE_ENV=development docusaurus start",
    "start": "dotenv -e .env.production -- cross-env NODE_ENV=production docusaurus start",
    "build": "dotenv -e .env.production -- cross-env NODE_ENV=production docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@docusaurus/core": "3.4.0",
    "@docusaurus/preset-classic": "3.4.0",
    "@docusaurus/theme-common": "3.4.0",
    "@docusaurus/theme-mermaid": "3.4.0",
    "@mdx-js/react": "^3.1.1",
    "@tabler/icons-react": "^3.41.1",
    "antd": "^5.29.3",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "docusaurus-plugin-sass": "^0.2.6",
    "dotenv-cli": "^8.0.0",
    "gray-matter": "^4.0.3",
    "jsonp": "^0.2.1",
    "lucide-react": "^0.525.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-player": "^2.16.1",
    "react-router-dom": "^7.18.1",
    "react-syntax-highlighter": "^15.6.6",
    "sass": "^1.98.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.4.0",
    "@docusaurus/types": "3.4.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^11.1.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-classnames": "^0.8.6",
    "prettier-plugin-merge": "^0.8.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.4.1"
